# Remotion Lambda (optional, only for cloud rendering)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Model provider API keys.
# Each key name maps to a provider's `apiKeyEnv` field in models.json.
# Only the providers you actually use need to be filled in.

# OpenAI
OPENAI_API_KEY=

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# Agnes (https://agnes-ai.com, OpenAI-compatible)
AGNES_API_KEY=
