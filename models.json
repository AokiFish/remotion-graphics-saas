{
  "defaultModel": "gpt-5.2:low",
  "auxModel": "gpt-5.2",
  "providers": {
    "openai": {
      "label": "OpenAI",
      "type": "openai",
      "baseURL": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY"
    },
    "openrouter": {
      "label": "OpenRouter",
      "type": "openai",
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "agnes": {
      "label": "Agnes",
      "type": "openai",
      "baseURL": "https://apihub.agnes-ai.com/v1",
      "apiKeyEnv": "AGNES_API_KEY"
    }
  },
  "models": [
    {
      "id": "gpt-5.2",
      "provider": "openai",
      "label": "GPT-5.2",
