    },
    {
      "id": "gpt-5.2-pro",
      "provider": "openai",
      "label": "GPT-5.2 Pro",
      "reasoningEfforts": ["medium", "high", "xhigh"]
    },
    {
      "id": "anthropic/claude-3.5-sonnet",
      "provider": "openrouter",
      "label": "Claude 3.5 Sonnet (OpenRouter)"
    },
    {
      "id": "google/gemini-2.5-pro",
      "provider": "openrouter",
      "label": "Gemini 2.5 Pro (OpenRouter)"
    },
    {
      "id": "openai/gpt-4o-mini",
      "provider": "openrouter",
      "label": "GPT-4o mini (OpenRouter)"
    },
    {
      "id": "agnes-2.5-flash",
      "provider": "agnes",
      "label": "Agnes 2.5 Flash"
    },
    {
      "id": "agnes-3.0-flash",
      "provider": "agnes",
      "label": "Agnes 3.0 Flash"
    }
  ]
}
